<% layout("/layouts/boilerplate") %>
<body>
    <br><br>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Create a new Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
             <lable for="title" class="form-label">Title</lable>
             <input name="listing[title]" placeholder="enter a awesome title" type="text" class="form-control" required>

             <div class="valid-feedback">Looks Good</div>
        </div>
       
        <div class="mb-3">
            <lable for="description" class="form-label">Description</lable>
            <textarea name="listing[description]"  type="text" class="form-control" required></textarea>

            <div class="invalid-feedback">Please!enter a valid desciption..</div>
        </div>
        
        <!-- <div class="mb-3">
            <lable for="image" class="form-label">Image Link</lable>
            <input name="listing[image][url]" placeholder="add link" type="text" class="form-control">
        </div> -->

        <div class="mb-3">
            <lable for="image" class="form-label">Upload Image</lable>
            <input name="listing[image][url]"  type="file" class="form-control" required>
           
        </div>
        
        <div class="mb-3">
             <lable for="price" class="form-label">Price</lable>
             <input name="listing[price]" placeholder="enter price" type="number" class="form-control" required>

             <div class="invalid-feedback">Please!Enter a Valid price.</div>
        </div>
        
        <div class="row">
            <div class="mb-3 col md-5">
             <lable for="location" class="form-label">Location</lable>
             <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>

             <div class="invalid-feedback">Please!Enter a Valid location</div>
            </div>
         
            <div class="mb-3 col md-5">
             <lable for="country" class="form-label">Country</lable>
            <input name="listing[country]" placeholder="enter country" type="text" class="form-control" required>

            <div class="invalid-feedback">Please!Enter a Country Name.</div>
            </div>
         
        </div>

         
        <br><br>
        <button class="btn btn-dark mt-tp-3 add-btn">Submit</button>
        <br><br>
    </form>
    </div>
    </div>
</body>
